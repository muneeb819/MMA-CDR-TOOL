APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Empty means same-origin relative URLs; Vite proxies to API_PROXY_TARGET.
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:8000

# SQL Server (primary). Run database/mma-cdr-sqlserver.sql in SSMS first.
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CDR_Intelligence
SQLSERVER_USER=cdr_app
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_POOL_SIZE=5
SQLSERVER_MAX_OVERFLOW=10

# Dev fallback without SQL Server:
MMA_CDR_USE_SQLITE=1
MMA_CDR_SQLITE_PATH=./mma-cdr.db

JWT_SECRET=CHANGE_ME
WSS_ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=256
STORE_RAW_UPLOADS=true

# Playwright targets (do not place real production credentials here).
BASE_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000
TEST_TENANT_ID=00000000-0000-0000-0000-000000000001
TEST_CAMPAIGN_ID=22222222-2222-4222-8222-222222222222

# Opt in only for a dedicated test database with the schema already installed.
RUN_SQLSERVER_TESTS=0
SQLSERVER_TEST_DATABASE=mma_cdr_test

# Remote service targets are blocked unless deliberately enabled for a dedicated QA environment.
QA_ALLOW_REMOTE_TARGET=0
PW_START_SERVERS=1
PW_REUSE_EXISTING=0

# Optional Rust parity integration (Cargo must be installed for auto-start).
# PW_START_RUST=1
# RUST_REFINERY_URL=http://127.0.0.1:9100
