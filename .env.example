APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_URL=http://localhost:8000

# SQL Server (primary). Run database/mma-cdr-sqlserver.sql in SSMS first.
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CDR_Intelligence
SQLSERVER_USER=cdr_app
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_POOL_SIZE=5
SQLSERVER_MAX_OVERFLOW=10

# Dev fallback without SQL Server:
MMA_CDR_USE_SQLITE=1
MMA_CDR_SQLITE_PATH=./mma-cdr.db

JWT_SECRET=CHANGE_ME
WSS_ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=256
STORE_RAW_UPLOADS=true
